# Copy to .env (or run scripts/dev-env.sh, which generates one) and fill in
# every value. docker-compose.yml has no defaults for secrets.
# Generate secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_TOKEN=
FILE_SIGNING_SECRET=

# Video rooms (LiveKit): any key name and a 32+ character secret.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: what browsers connect to (default ws://localhost:7880). On a server:
# wss://<your domain>/livekit behind Caddy, LIVEKIT_BIND=0.0.0.0,
# LIVEKIT_USE_EXTERNAL_IP=true, and open TCP 7881 + UDP 52000-52100.
# LIVEKIT_PUBLIC_URL=

# The first admin account, created on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_CAMPUS_SLUG=

# Public URL of the web app, used in email links; sender of every email.
APP_URL=
MAIL_FROM=
# Optional: a real mail provider. Leave unset to use the local Mailpit inbox.
# Gmail: use a dedicated account with 2-step verification on, and an App
# Password (myaccount.google.com/apppasswords), never the account password.
# MAIL_FROM must then be that Gmail address, e.g. "Your Mate <you@gmail.com>".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=the-16-letter-app-password
# Optional: where new reports and contact messages are sent.
STAFF_EMAIL=

# false in production: disables the playground and introspection, makes cookies Secure.
DEV_MODE=false
DEBUG=false

# ── Optional rules (defaults shown) ──────────────────────────────────────────
# Sign-in (identity)
# OTP_TTL=10m
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_GAP=60s
# OTP_MAX_PER_HOUR=5
# LOGIN_FAILURE_WINDOW=15m
# LOGIN_MAX_FAILURES=10
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h

# Bookings (marketplace)
# BOOKING_LEAD_TIME=2h
# BOOKING_DEFAULT_DAYS=14
# BOOKING_MAX_DAYS=28
# BOOKING_MAX_OPEN_REQUESTS=5
# BOOKING_AUTO_COMPLETE_AFTER=48h
# SESSION_DURATIONS=30,60,90,120

# Communities and feed (community)
# COMMUNITY_MAX_OWNED=3
# COMMUNITY_DECLINE_COOLDOWN=168h
# COMMUNITY_REMOVAL_BAN=720h
# COMMUNITY_POSTS_PER_HOUR=20
# COMMUNITY_REPLIES_PER_HOUR=60
# FEED_MAX_PENDING_POSTS=5
# CONTACT_PER_HOUR=3
# DM_NEW_PER_HOUR=10
# DM_PENDING_LIMIT=3
# Resume reviews: open reviews per student, how long a request waits for the
# mentor, how long uploads are kept after a review closes, longest turnaround.
# RESUME_MAX_OPEN=3
# RESUME_REQUEST_TTL=72h
# RESUME_FILE_RETENTION=720h
# RESUME_MAX_TURNAROUND_DAYS=14
